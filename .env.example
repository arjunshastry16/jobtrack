# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- dev database (compose.dev.yml) ---
JOBTRACK_DEV_DB_PASSWORD=jobtrack
JOBTRACK_DEV_DB_PORT=5433
# Where Postgres stores its files on the host (default ./.data/postgres)
# JOBTRACK_DEV_PGDATA=/mnt/bigdisk/jobtrack/dev-pg

# --- API (cmd/api, cmd/migrate) ---
JOBTRACK_DATABASE_URL=postgres://jobtrack:jobtrack@127.0.0.1:5433/jobtrack?sslmode=disable
JOBTRACK_ADDR=127.0.0.1:8090
JOBTRACK_LOG_LEVEL=info

# --- tests ---
# Admin connection used by integration tests: each test creates (and drops) its own
# database on this server. Point it at the dev Postgres; unset = DB tests are skipped.
JOBTRACK_TEST_DATABASE_URL=postgres://jobtrack:jobtrack@127.0.0.1:5433/postgres?sslmode=disable
