        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pg_stat_database_blks_hit{job=\"postgres\", datname=\"jobtrack\"}[$__range])) / (sum(increase(pg_stat_database_blks_hit{job=\"postgres\", datname=\"jobtrack\"}[$__range])) + sum(increase(pg_stat_database_blks_read{job=\"postgres\", datname=\"jobtrack\"}[$__range])))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
