# Production settings: copy to ~/stacks/jobtrack/.env and `chmod 600` it. Never commit
# the real file.

# The image to run, pinned to a digest (step 4.4's deploy script maintains this).
JOBTRACK_IMAGE=ghcr.io/arjunshastry16/jobtrack:sha-0000000@sha256:<digest>

# Postgres password, used only inside the stack's internal network. Hex so it's safe in
# a URL: openssl rand -hex 24
JOBTRACK_DB_PASSWORD=

# Where the database lives (the USB HDD).
JOBTRACK_DATA_DIR=/mnt/cnimbus/jobtrack

# Tailscale logins allowed in (comma-separated); `tailscale status --json` shows yours.
JOBTRACK_ALLOWED_LOGINS=

# ntfy topic for reminders (long and random; see the main .env.example). Unset = log only.
JOBTRACK_NTFY_URL=
# JOBTRACK_NTFY_TOKEN=

TZ=Asia/Kolkata
JOBTRACK_SYNC_HOUR=6
JOBTRACK_REMINDER_AFTER_DAYS=7
JOBTRACK_REMINDER_HOURS=9-21
